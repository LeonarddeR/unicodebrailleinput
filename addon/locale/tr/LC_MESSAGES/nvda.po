#. Translators: the label of an input type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:39
msgid "Braille dots (e.g. 1345-1236-145-1)"
msgstr "Braille noktaları (Örneğin: 1345-1236-145-1)"

#. Translators: the label of an input type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:41
#: addon\globalPlugins\unicodeBrailleInput\interface.py:45
msgid "Normal text according to {table}"
msgstr "{table} Göre Normal metin"

#. Translators: the label of an output type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:60
msgid "Unicode braille"
msgstr "Unicode braille"

#. Translators: the label of an output type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:62
msgid "ASCII braille (BRF)"
