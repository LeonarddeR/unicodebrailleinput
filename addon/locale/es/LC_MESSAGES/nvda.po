#. Translators: The label for a button to import text.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:226
msgid "I&mport..."
msgstr "&Importar..."

#. Translators: the label of the combo box to choose the input type.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:236
msgid "Input &type:"
msgstr "&Tipo de entrada:"

#. Translators: the label of the radio box to choose the output type.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:244
msgid "&Output type:"
msgstr "Tipo de &salida:"

#. Translators: Label for a checkbox, wether to use a regular space or the Braille unicode space.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:254
msgid "Convert Unicode Braille &space to ASCII space"
msgstr "&Convertir espacio braille Unicode a espacio ASCII"

