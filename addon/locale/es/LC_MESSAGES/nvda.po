#: addon\globalPlugins\unicodeBrailleInput\interface.py:275
msgid "Import File"
msgstr "Importar archivo"

#. Translators: Dialog text presented when NVDA can't import a file.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:288
msgid "Error importing file: {e}"
msgstr "Error al importar el archivo: {e}"

#. Translators: the title of an error message dialog
#: addon\globalPlugins\unicodeBrailleInput\interface.py:290
#: addon\globalPlugins\unicodeBrailleInput\interface.py:321
#: addon\globalPlugins\unicodeBrailleInput\interface.py:365
msgid "Error"
msgstr "Error"

#. Translators: Label of a dialog to export a file.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:305
