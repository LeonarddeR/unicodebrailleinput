#. Translators: the label of an input type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:39
msgid "Braille dots (e.g. 1345-1236-145-1)"
msgstr "Брайлови точки (напр. 1345-1236-145-1)"

#. Translators: the label of an input type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:41
#: addon\globalPlugins\unicodeBrailleInput\interface.py:45
msgid "Normal text according to {table}"
msgstr "Нормален текст съгласно {table}"

#. Translators: the label of an output type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:60
msgid "Unicode braille"
msgstr "Уникод Брайл"

#. Translators: the label of an output type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:62
msgid "ASCII braille (BRF)"
msgstr "ASCII брайл (BRF)"

#. Translators: the label of an output type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:64
msgid "NABCC"
msgstr "NABCC"

#. Translators: the label of an export type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:76
msgid "Clipboard"
msgstr "Клипборд"

#. Translators: the label of an export type
#: addon\globalPlugins\unicodeBrailleInput\interface.py:78
msgid "File"
msgstr "Файл"

#. Translators: Error message displayed when the user enters invalid input.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:179
#, python-format
msgid "Unexpected input: '%s', only dots 0 to 8 and - are allowed."
msgstr "Неочаквани входящи данни: '%s', позволени са само точки от 0 до 8 и тире (-)."

#. Translators: The title of the dialog.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:212
msgid "Convert Braille"
msgstr "Конвертиране на брайл"

#. Translators: the label of the edit field.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:218
msgid "&Input:"
msgstr "&Въвеждане:"

#. Translators: The label for a button to import text.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:226
msgid "I&mport..."
msgstr "И&мпортирай..."

#. Translators: the label of the combo box to choose the input type.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:236
msgid "Input &type:"
msgstr "&Тип въвеждане:"

#. Translators: the label of the radio box to choose the output type.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:244
msgid "&Output type:"
msgstr "Тип и&звеждане:"

#. Translators: Label for a checkbox, wether to use a regular space or the Braille unicode space.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:254
msgid "Convert Unicode Braille &space to ASCII space"
msgstr "Конвертира уникод брайлови ин&тервали до ASCII интервали"

#. Translators: the label of the combo box to choose the export type.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:263
msgid "&Export to:"
msgstr "&Експортиране в:"

#. Translators: Label of a dialog to import a file.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:275
msgid "Import File"
msgstr "Импортиране на файл"

#. Translators: Dialog text presented when NVDA can't import a file.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:288
msgid "Error importing file: {e}"
msgstr "Грешка при импортиране на файл: {e}"

#. Translators: the title of an error message dialog
#: addon\globalPlugins\unicodeBrailleInput\interface.py:290
#: addon\globalPlugins\unicodeBrailleInput\interface.py:321
#: addon\globalPlugins\unicodeBrailleInput\interface.py:365
msgid "Error"
msgstr "Грешка"

#. Translators: Label of a dialog to export a file.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:305
msgid "Export File"
msgstr "Експортиране на файл"

#. Translators: Dialog text presented when NVDA can't export a file.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:319
msgid "Error exporting file: {e}"
msgstr "Грешка при експортиране на файл: {e}"

#. Translators: This is the message when unicode text has been copied to the clipboard.
#: addon\globalPlugins\unicodeBrailleInput\interface.py:363
msgid "Result copied to clipboard ready for you to paste."
msgstr "Резултатът е копиран в клипборда, готов за поставяне."

#. Translators: name of menu item.
#: addon\globalPlugins\unicodeBrailleInput\__init__.py:36
msgid "Un&icode Braille Input..."
msgstr "Въвеждане на брайл на &уникод..."

#. Translators: menu item tool tip text.
#. Translators: Message presented when user performs input help for this shortcut.
#: addon\globalPlugins\unicodeBrailleInput\__init__.py:38
#: addon\globalPlugins\unicodeBrailleInput\__init__.py:44
msgid "Displays a dialog to enter braille in numeric form."
msgstr "Извежда диалог за въвеждане на брайл чрез цифри."

#: buildVars.py:14
msgid "Unicode Braille Input"
msgstr "Въвеждане на брайл на уникод (Unicode Braille Input)"

#: buildVars.py:15
msgid "Utilities to convert text to Unicode braille"
msgstr "Помощни програми за конвертиране на текст в уникод брайл"

